// 共享工具类：ProtoBuf 序列化辅助
// 放入 GameBackend.Shared 项目中，客户端和服务端共用

using System;
using System.IO;

namespace MMO.Proto
{
    /// <summary>ProtoBuf 消息的通用扩展方法</summary>
    public static class ProtoExtensions
    {
        /// <summary>将 proto 消息序列化为 byte[]</summary>
        public static byte[] Serialize<T>(this T message) where T : Google.Protobuf.IMessage
        {
            using var ms = new MemoryStream();
            message.WriteTo(ms);
            return ms.ToArray();
        }

        /// <summary>从 byte[] 反序列化 proto 消息</summary>
        public static T Deserialize<T>(byte[] data) where T : Google.Protobuf.IMessage<T>, new()
        {
            var msg = new T();
            msg.MergeFrom(data);
            return msg;
        }

        /// <summary>构建 [4B 长度 + body] 的 TCP 包</summary>
        public static byte[] BuildTcpPacket(byte[] body)
        {
            var pkt = new byte[4 + body.Length];
            BitConverter.GetBytes(body.Length).CopyTo(pkt, 0);
            body.CopyTo(pkt, 4);
            return pkt;
        }
    }
}
